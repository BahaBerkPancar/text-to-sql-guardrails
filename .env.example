# Copy to .env and change the values. .env is never committed.
POSTGRES_PASSWORD=change-me
READONLY_PASSWORD=change-me-too
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/app
READONLY_DATABASE_URL=postgresql+psycopg://t2s_readonly:change-me-too@127.0.0.1:5432/app
READONLY_ROLE=t2s_readonly
STATEMENT_TIMEOUT_MS=3000
POLICY_PATH=config/policy.toml

# Set an API key, or authenticate locally with `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_S=60
